{
  "name": "@billie/billie",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13"
  },
  "tasks": {
    "dev": "deno run --allow-env --allow-read --allow-write --allow-net --allow-run=typst src/main.ts",
    "build": "deno compile --allow-env --allow-read --allow-write --allow-net --allow-run=typst --output dist/billie src/main.ts",
    "check": "deno fmt --check && deno lint && deno check src/main.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-run=typst"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
