{
  "name": "@billie/billie",
  "version": "1.2.0",
  "exports": "./src/main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@streamparser/json": "npm:@streamparser/json@0.0.22",
    "marked": "npm:marked@17.0.1"
  },
  "tasks": {
    "dev": "deno run --allow-env --allow-read --allow-write --allow-net --allow-run=typst,micro src/main.ts",
    "build": "deno compile --allow-env --allow-read --allow-write --allow-net --allow-run=typst,micro --output dist/billie src/main.ts",
    "check": "deno fmt --check && deno lint && deno check src/main.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-run=typst,micro"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
